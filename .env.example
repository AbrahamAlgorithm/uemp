POSTGRES_DB=uemp
POSTGRES_USER=uemp
POSTGRES_PASSWORD=uemp
POSTGRES_PORT=5433

DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=django-insecure-local-dev-only-not-for-production
DEBUG=true
DATABASE_URL=postgres://uemp:uemp@localhost:5433/uemp
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,api

CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
# proxies that append the client ip to X-Forwarded-For, used for the login throttle and audit ips
NUM_PROXIES=0
# password for every account created by manage.py seed_demo
SEED_PASSWORD=Demo@2026

API_URL=http://localhost:8000

