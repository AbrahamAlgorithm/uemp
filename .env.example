# Copy to .env at the repo root. Everything here is optional for local development:
# docker compose and the Django dev settings fall back to these same defaults.
# Never commit a real .env.

# --- Postgres (docker compose "db" service) -----------------------------------
POSTGRES_DB=uemp
POSTGRES_USER=uemp
POSTGRES_PASSWORD=uemp
# Host port the container's 5432 is published on.
POSTGRES_PORT=5433

# --- Django API (backend/) ------------------------------------------------------
# config.settings.dev for local work (manage.py and pytest default to it);
# the production image sets config.settings.prod.
DJANGO_SETTINGS_MODULE=config.settings.dev
# Required in prod. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=django-insecure-local-dev-only
# Read by dev settings only; prod always runs with DEBUG=False.
DEBUG=true
# Used by host-side runs (pytest, manage.py). docker compose builds its own URL
# pointing at the "db" service. On Cloud Run, use the Cloud SQL unix socket:
#   postgres://USER:PASSWORD@%2Fcloudsql%2FPROJECT%3AREGION%3AINSTANCE/DBNAME
DATABASE_URL=postgres://uemp:uemp@localhost:5433/uemp
# Comma-separated. Keep "api": the Next.js proxy sends it as the Host header in compose.
ALLOWED_HOSTS=localhost,127.0.0.1,api
# Comma-separated origins (scheme + host + port). In prod, the uemp-web URL.
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# --- Next.js web (frontend/) --------------------------------------------------
# Where the Next.js server proxies /api/*. Defaults to http://localhost:8000; compose
# sets http://api:8000. Baked in at build time for the production image.
API_URL=http://localhost:8000

# --- Both containers ----------------------------------------------------------
# Port the production containers listen on. Cloud Run sets it; defaults to 8080.
# PORT=8080
